{
  "name": "mcp-context-cost",
  "version": "0.18.0",
  "description": "Measure what your MCP servers cost in context tokens — audit your own config, or badge the server you publish",
  "type": "module",
  "license": "MIT",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athakur3/mcp-context-cost.git"
  },
  "homepage": "https://athakur3.github.io/mcp-context-cost/",
  "bugs": "https://github.com/athakur3/mcp-context-cost/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tokens",
    "context-window",
    "audit",
    "token-budget",
    "claude",
    "cursor",
    "badge",
    "shields",
    "developer-tools"
  ],
  "bin": {
    "mcp-context-cost": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test && npm run typecheck",
    "test": "vitest run",
    "test:badge": "./upstream/tests/badge-test.sh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "lint": "oxlint -D correctness -D perf -D suspicious src tools test spec",
    "format": "prettier --write \"{src,tools,test,spec}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tools,test,spec}/**/*.ts\"",
    "adoption": "tsx tools/measure-adoption.ts",
    "scan-registry": "tsx tools/scan-registry.ts",
    "cross-check": "tsx src/sweep/cross-check.ts",
    "divergence": "tsx tools/measure-divergence.ts",
    "sweep": "tsx src/sweep/run.ts",
    "sweep:all": "tsx src/sweep/sweep-all.ts",
    "verify": "tsx src/cli.ts verify",
    "check:release": "tsx tools/release-readiness.ts",
    "cut": "tsx tools/cut-changelog.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21",
    "smol-toml": "1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@types/node": "^26.2.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
